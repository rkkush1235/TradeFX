# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# mobile app (Expo / React Native)
mobile-app/
mobile-app/.expo/
mobile-app/android/
mobile-app/ios/
mobile-app/node_modules/
mobile-app/.gradle/
mobile-app/dist/
mobile-app/build/

# generated app artifacts
public/downloads/*.apk
public/downloads/*.aab

# local editor files
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
