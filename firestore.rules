rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuth() && request.auth.uid == userId && request.resource.data.role == 'user';
      allow update: if isAdmin() || (
        isAuth() &&
        request.auth.uid == userId &&
        resource.data.uid == request.resource.data.uid &&
        resource.data.email == request.resource.data.email &&
        resource.data.role == request.resource.data.role &&
        resource.data.createdAt == request.resource.data.createdAt
      );
      allow delete: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /trades/{tradeId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /transactions/{txId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    match /deposits/{requestId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /withdrawals/{requestId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /marketPrices/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();

      match /history/{asset}/{candleId} {
        allow read: if isAuth();
        allow write: if isAdmin();
      }
    }

    match /system/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /bankAccounts/{accountId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }
  }
}
